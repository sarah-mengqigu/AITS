# ---- Django ----
AITS_ENV=dev
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_BASE_URL=http://127.0.0.1:5173
SITE_URL=http://127.0.0.1:5173

# ---- Database ----
DB_ENGINE=sqlite
# DB_ENGINE=postgres
DB_NAME=aits
DB_USER=aits
DB_PASSWORD=aits
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- Redis (cache / broker / channel layer) ----
# Without Redis the platform falls back to in-memory cache + eager Celery.
USE_REDIS=0
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=0

# ---- Execution engines ----
# simulated -> deterministic in-process (demo / CI)
# real      -> Playwright / Locust / HttpRunner subprocesses
AITS_EXECUTION_MODE=simulated

# ---- AI ----
AI_MOCK_MODE=0
AI_REQUEST_TIMEOUT=120
AITS_MAX_AGENT_STEPS=12
# Model credentials are managed in the UI (LLMConfiguration) - nothing to put here.

# ---- Mobile (Sonic) ----
SONIC_BASE_URL=
SONIC_API_PREFIX=/server/api
SONIC_USERNAME=
SONIC_PASSWORD=
SONIC_TOKEN=
SONIC_PROJECT_ID=

# ---- Observability ----
# File SD target file is rewritten at runtime by utils/prometheus_sd.py
PROMETHEUS_SD_AUTO_UPDATE=1
WINDOWS_EXPORTER_PORT=9182
GRAFANA_AI_NOTIFY_RECEIVER_ID=
GRAFANA_AI_NOTIFY_RECEIVER_NAME_KEYWORD=AI测试部门群

# ---- Email fallback (overridden by EmailConfig in DB) ----
DEFAULT_FROM_EMAIL=aits@example.com
